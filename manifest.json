{
    "manifest_version": 3,
    "name": "ARU Timetable Visualizer",
    "version": "1.0",
    "description": "เปลี่ยนรูปแบบตารางเรียน ARU ให้ดูง่ายขึ้น",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "ARU Timetable Visualizer"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "style.css"
            ],
            "all_frames": true
        }
    ]
}